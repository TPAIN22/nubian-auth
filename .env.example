# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Image Upload ────────────────────────────────────────────────────────────
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS (comma-separated list of allowed frontend origins) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.nubian-sd.store,https://nubian-sd.store

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Affiliate / Referral ────────────────────────────────────────────────────
DEFAULT_COMMISSION_RATE=0.10
DEFAULT_DISCOUNT_RATE=0.10
AFFILIATE_BASE_URL=https://www.nubian-sd.com
MAX_REFERRAL_CLICKS_PER_IP=10
FRAUD_SCORE_THRESHOLD=80

# ─── Dashboard ───────────────────────────────────────────────────────────────
# Base URL used to build links that point back into the dashboard — currently
# the store team invitation accept link. Falls back to AFFILIATE_BASE_URL.
DASHBOARD_BASE_URL=https://www.nubian-sd.com

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Nubian's default margin, in percent, added on top of the merchant's price:
#   listed = merchantPrice × (1 + NUBIAN_MARKUP/100)
# This is THE knob for the platform margin — nothing else hardcodes the number.
# Range 0–200 (matches the schema). Invalid values log a warning and fall back
# to 30 rather than crashing the API.
#
# Scope: it sets the default for new variants and every fallback path. It does
# NOT rewrite products already stored with an explicit markup — for that run:
#   node src/scripts/migrate_nubian_markup.js
#
# The clients keep their own copy purely as an offline fallback; when you change
# this, mirror it in apps/dashboard (NEXT_PUBLIC_NUBIAN_MARKUP) and apps/mobile
# (EXPO_PUBLIC_NUBIAN_MARKUP).
NUBIAN_MARKUP=8

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
ENABLE_CRONS=false

# ─── MongoDB Connection Pool (optional) ──────────────────────────────────────
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=2

# ─── Redis / Queue ───────────────────────────────────────────────────────────
# Connection string for Redis (BullMQ). Required when ENABLE_QUEUE=true.
# Local dev:    redis://localhost:6379
# Upstash:      rediss://default:<password>@<host>.upstash.io:<port>
# Other managed: rediss://default:<password>@<host>:<port>
# Note: BullMQ requires Redis ≥6.2 (streams). Upstash, Render, Railway are fine.
REDIS_URL=redis://localhost:6379

# Optional namespace prefix — useful if multiple environments share one Redis.
# Effective queue names become "<REDIS_PREFIX>:nubian_notif_<channel>".
# REDIS_PREFIX=

# Master switch for the queue-based notification pipeline.
# true  = enqueue notifications to BullMQ; workers do the actual delivery.
# false = synchronous fallback (legacy behavior, no Redis required).
ENABLE_QUEUE=true

# ─── Workers ─────────────────────────────────────────────────────────────────
# Comma-separated roles for the worker process (only used when running
# `npm run worker`). Valid: push, email, sms, fanout, maintenance, all
WORKER_ROLES=push,email,fanout,maintenance

# Run workers inside the API process instead of a separate dyno.
# Convenient for single-dyno deploys; not recommended at scale.
#
# IMPORTANT: this is an either/or with a separate `npm run worker` service. If
# both are running, every role is hosted twice and you pay twice the idle Redis
# polling for no extra throughput.
RUN_WORKERS_INPROCESS=false

# Idle-polling tuning. An idle worker still costs ~2 Redis commands per
# WORKER_DRAIN_DELAY_S, per role — the dominant cost on per-command Redis plans
# (Upstash) at low traffic. Raising the drain delay is nearly free: enqueuing a
# job writes the marker key and wakes the blocking read immediately, so this is
# only the fallback timeout when nothing is being enqueued. Delayed jobs (retry
# backoff, cron schedulers) wake on their own due timestamp, not this.
# Going much above 120 is not recommended — BullMQ's reconnect watchdog fires at
# this value + 1s, so a silently dropped connection stays undetected that long.
# WORKER_DRAIN_DELAY_S=120
#
# How often to sweep for jobs orphaned by a crashed worker. Longer = cheaper,
# but a dead worker's job stays unowned for up to this long.
# WORKER_STALLED_INTERVAL_MS=600000

# Optional per-queue concurrency overrides. Defaults baked in are sane for a
# small deploy; raise these if a queue is consistently backed up.
# PUSH_WORKER_CONCURRENCY=10
# EMAIL_WORKER_CONCURRENCY=5
# FANOUT_WORKER_CONCURRENCY=3

# ─── Maps & geocoding ────────────────────────────────────────────────────────
# All map/geocoding traffic is proxied through /api/geo, so vendor keys stay on
# the server and NEVER reach the mobile bundle or the browser. Switching
# provider is an env change here plus a redeploy — no app release, no code
# change, no schema change. See src/services/geo/ for the adapter layer.

# Active provider. One of: google | nominatim | none
#   google    — Google Maps Platform (Geocoding + Places + Static Maps)
#   nominatim — OpenStreetMap. Free; also speaks the LocationIQ / MapTiler API,
#               so pointing GEO_NOMINATIM_URL at a paid host gives production
#               rate limits with no code change.
#   none      — no geocoding. The map picker still works: shoppers drop a pin
#               and describe the place themselves. Nothing breaks.
GEO_PROVIDER=nominatim

# Ordered fallbacks tried when the primary fails or is unconfigured.
# GEO_FALLBACK_PROVIDERS=nominatim

# ── Google provider ──
# Restrict this key to the Geocoding and Places APIs, by IP, in Google Cloud.
# GEO_GOOGLE_API_KEY=
# Optional separate key for Static Maps (different quota/restrictions).
# GEO_GOOGLE_STATIC_API_KEY=

# ── OpenStreetMap / Nominatim provider ──
# Defaults to the public OSM instance, which allows ~1 req/sec and is rate
# limited to a crawl. Fine for development; point this at a self-hosted or
# commercial endpoint before relying on it in production.
# GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEO_NOMINATIM_KEY=
# Contact email — required by the public OSM usage policy.
# GEO_NOMINATIM_EMAIL=
# Minimum gap between outbound calls, ms. Set 0 for a commercial host.
# GEO_NOMINATIM_MIN_INTERVAL_MS=1100

# ── Client map rendering ──
# Raster tile template handed to clients so they can render a map without
# knowing the vendor. Any XYZ source works.
# GEO_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GEO_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Map centre when a device has no GPS fix. Default: Khartoum.
GEO_DEFAULT_LAT=15.5007
GEO_DEFAULT_LNG=32.5599
GEO_DEFAULT_ZOOM=15

# Bias/restrict search to these ISO country codes (comma separated, lowercase).
# Leave empty for worldwide. Phase 1 wedge is Sudanese buyers in the Gulf.
# GEO_COUNTRY_CODES=sd,sa,ae,qa,kw,bh,om

# ── Tuning ──
# Client-side debounce, served via /api/geo/config so it can be tuned per
# provider without shipping a new app build.
# GEO_CLIENT_DEBOUNCE_MS=500
# GEO_CLIENT_SEARCH_DEBOUNCE_MS=350
# Server-side cache. Reverse-geocode results are snapped to a ~11m grid.
# GEO_CACHE_TTL_MS=86400000
# GEO_SEARCH_CACHE_TTL_MS=600000
# GEO_CACHE_MAX_ENTRIES=5000
# GEO_TIMEOUT_MS=6000
# GEO_DEFAULT_LANGUAGE=en

# ── Rate limiting & IP denylist ──────────────────────────────────────────────
# Backing store for rate limit counters.
#   auto   (default) use Redis when REDIS_URL is set, else in-memory
#   redis  require Redis; boot fails if REDIS_URL is missing
#   memory force in-memory (per-process, resets on restart) — dev only
# In-memory means each instance enforces its own limit: N instances = N x limit.
# RATE_LIMIT_STORE=auto

# Auto-ban IPs that repeatedly trip rate limits. Bans are stored in Redis and
# shared across instances (each instance refreshes its snapshot every
# IP_BAN_SYNC_MS). Manage them at /api/admin/security/bans.
# ENABLE_IP_BAN=true
# IP_BAN_VIOLATION_THRESHOLD=5        # 429s within the window before a ban
# IP_BAN_VIOLATION_WINDOW_MS=600000   # 10 min
# IP_BAN_DURATION_MS=3600000          # 1 h, doubles per repeat offence
# IP_BAN_MAX_DURATION_MS=86400000     # 24 h cap
# IP_BAN_OFFENCE_MEMORY_MS=604800000  # 7 d — how long offences escalate
# IP_BAN_SYNC_MS=15000                # cross-instance ban propagation delay

# Exact IPs (comma separated) exempt from rate limiting AND banning. Put
# monitoring, office, and partner-integration IPs here — an automated ban on one
# of these would take out your own tooling.
# IP_ALLOWLIST=
# Exact IPs blocked outright, no expiry.
# IP_DENYLIST=

# Shared secret that lets the dashboard forward the real end-user IP (header
# x-nubian-client-ip). Without it, every request the dashboard proxies is
# attributed to its egress IP and the whole dashboard shares ONE rate-limit
# bucket. Must match INTERNAL_PROXY_SECRET in the dashboard's env.
# Generate: openssl rand -hex 32
# INTERNAL_PROXY_SECRET=

# Tuning for the rate-limit Redis client (hot path — fails fast, then trips a
# circuit breaker and serves from memory rather than adding latency per request).
# RATE_LIMIT_REDIS_TIMEOUT_MS=300
# RATE_LIMIT_BREAKER_FAILURES=5
# RATE_LIMIT_BREAKER_COOLDOWN_MS=30000
